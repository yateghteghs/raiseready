# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
# Recommended: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Paystack (use test keys until going live)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Set to true only after Paystack has enabled USD for the business.
PAYSTACK_USD_ENABLED=

# Mailtrap Email API token (mailtrap.io -> Sending Domains -> indexprima.com
# -> Integration -> API). Optional; without it the app emails nothing itself.
# Sign-up and password emails are sent by Supabase (its own SMTP settings).
MAILTRAP_API_TOKEN=
# Optional: Supabase "Send Email" hook secret (Authentication -> Hooks), so
# sign-up and password emails go through Mailtrap's API instead of SMTP.
SEND_EMAIL_HOOK_SECRET=

# Public base URL of this app, e.g. http://localhost:3000
APP_URL=http://localhost:3000
